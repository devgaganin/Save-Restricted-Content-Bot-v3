# Copy to .env and fill locally. Never commit secrets.
API_ID=
API_HASH=
BOT_TOKEN=
MONGO_DB=
DB_NAME=telegram_downloader
# Space-separated Telegram numeric user IDs
OWNER_ID=
# Required for private-session encryption. Existing sessions require the same keys.
MASTER_KEY=
IV_KEY=
# 0 disables force subscription
FORCE_SUB=0
# LOG_GROUP=-1001234567890
FREEMIUM_LIMIT=0
PREMIUM_LIMIT=500
# Optional Telegram Premium user session for large-file uploads
STRING=
ADMIN_CONTACT=https://t.me/your_support
# Telegram Stars plan prices and durations (d, w, m)
PLAN_D_S=1
PLAN_D_DU=1
PLAN_D_U=days
PLAN_W_S=3
PLAN_W_DU=1
PLAN_W_U=weeks
PLAN_M_S=5
PLAN_M_DU=1
PLAN_M_U=month

# Enable only in an isolated deployment with outbound-network controls.
ENABLE_EXTERNAL_DOWNLOADS=false
# Legacy deployments only; encrypted data must be migrated before changing keys.
ALLOW_INSECURE_LEGACY_KEYS=false

# Optional Razorpay payment links; check Telegram/platform rules before enabling.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prices are in paise. Zero disables that plan.
RAZORPAY_PLAN_D_PAISE=0
RAZORPAY_PLAN_W_PAISE=0
RAZORPAY_PLAN_M_PAISE=0

# Optional manual gift-card reference review. Never submit redemption codes.
GIFT_ENABLED=false
GIFT_PLAN_D_VALUE=Contact support
GIFT_PLAN_W_VALUE=Contact support
GIFT_PLAN_M_VALUE=Contact support

# Optional opt-in premium expiry reminders (one best-effort attempt per expiry).
EXPIRY_REMINDERS_ENABLED=false
EXPIRY_REMINDER_HOURS=24
EXPIRY_REMINDER_INTERVAL_SECONDS=900
